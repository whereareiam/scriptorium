{
  "name": "Scriptorium Starter",
  "description": "Shared docs shell.",
  "logo": "docs/assets/logo.svg",
  "defaultRef": "release",
  "refRules": {
    "defaultBranch": "dev",
    "releaseBranchPrefix": "release/",
    "includeDefaultRef": true,
    "includeReleaseBranches": true,
    "includeTags": true,
    "extraRefs": [
      "dev"
    ]
  },
  "refs": {
    "release": {
      "label": "Release",
      "description": "Stable release branch used as the default example.",
      "theme": {
        "primary": "hsl(28 100% 56%)",
        "primaryForeground": "hsl(0 0% 7%)",
        "ring": "hsl(28 100% 56%)",
        "accent": "hsla(28 100% 56% / 0.14)",
        "accentForeground": "hsl(28 100% 86%)"
      }
    },
    "dev": {
      "label": "Development",
      "description": "Secondary branch for ongoing development.",
      "theme": {
        "primary": "hsl(217 100% 64%)",
        "primaryForeground": "hsl(0 0% 7%)",
        "ring": "hsl(217 100% 64%)",
        "accent": "hsla(217 100% 64% / 0.14)",
        "accentForeground": "hsl(217 100% 86%)"
      }
    },
    "1.0.1": {
      "label": "1.0.1",
      "description": "Example tagged release.",
      "theme": {
        "primary": "hsl(28 100% 56%)",
        "primaryForeground": "hsl(0 0% 7%)",
        "ring": "hsl(28 100% 56%)",
        "accent": "hsla(28 100% 56% / 0.14)",
        "accentForeground": "hsl(28 100% 86%)"
      }
    }
  },
  "links": [
    {
      "label": "Repository",
      "url": "https://github.com/example/project"
    }
  ]
}
