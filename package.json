{
  "name": "scriptorium",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:local",
    "dev:local": "tsx src/cli/prepare-site.ts && next dev",
    "dev:built": "next start",
    "build": "tsx src/cli/prepare-site.ts && next build",
    "typecheck": "next typegen && tsc --noEmit",
    "validate": "npm run typecheck && npm run test && npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@fumadocs/local-md": "^0.2.1",
    "fumadocs-core": "^16.8.5",
    "fumadocs-ui": "^16.8.5",
    "lucide-react": "^1.12.0",
    "next": "^16.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "semver": "^7.7.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "postcss": "^8.5.12",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
