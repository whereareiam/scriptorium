{
  "name": "scriptorium",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "bun src/cli/prepare-site.ts && next dev",
    "dev:local": "bun src/cli/prepare-site.ts && next dev",
    "dev:built": "bun .next/standalone/server.js",
    "build": "bun src/cli/prepare-site.ts && next build",
    "typecheck": "next typegen && tsc --noEmit",
    "validate": "next typegen && tsc --noEmit && bun test && bun src/cli/prepare-site.ts && next build",
    "test": "bun test"
  },
  "dependencies": {
    "@fumadocs/local-md": "^0.2.1",
    "fumadocs-core": "^16.8.5",
    "fumadocs-ui": "^16.8.5",
    "lucide-react": "^1.12.0",
    "next": "^16.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "semver": "^7.7.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/bun": "^1.3.2",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "postcss": "^8.5.12",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3"
  }
}
