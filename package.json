{
  "name": "scriptorium",
  "private": true,
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "app",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd app dev",
    "dev:local": "bun run --cwd app dev",
    "dev:built": "bun run --cwd app dev:built",
    "build": "bun run --cwd app build",
    "typecheck": "bun run --cwd app typecheck",
    "validate": "bun test && bun run --cwd app typecheck && bun run --cwd app build",
    "test": "bun test"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/bun": "^1.3.2",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "next": "^16.2.4",
    "postcss": "^8.5.12",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3"
  }
}
