{
  "name": "Scriptorium Starter",
  "description": "Shared docs shell.",
  "logo": "docs/assets/logo.svg",
  "urls": {
    "github": "https://github.com/example/project"
  },
  "i18n": {
    "default": "en",
    "languages": {
      "en": {
        "label": "English"
      },
      "ru": {
        "label": "Русский"
      }
    }
  },
  "versions": {
    "home": "dev",
    "include": [
      {
        "type": "tag",
        "pattern": "*"
      }
    ],
    "meta": {
      "dev": {
        "label": "Development",
        "theme": {
          "primary": "hsl(217 100% 64%)",
          "primaryForeground": "hsl(0 0% 7%)",
          "ring": "hsl(217 100% 64%)",
          "accent": "hsla(217 100% 64% / 0.14)",
          "accentForeground": "hsl(217 100% 86%)"
        }
      }
    }
  }
}
